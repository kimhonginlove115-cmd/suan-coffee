# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HMAC-SHA256 authentication tokens.
SESSION_SECRET=""

# ADMIN_PIN: Default owner PIN for the admin console (override via Admin Settings).
ADMIN_PIN="1234"

# TELEGRAM_BOT_TOKEN: Official Telegram Bot token from @BotFather (used for Login Widget, Bot OTP & Order Alerts).
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_BOT_USERNAME: Official Telegram Bot username without @ (e.g. EmeraldBrewBot).
TELEGRAM_BOT_USERNAME=""

# TELEGRAM_CHAT_ID: Telegram Group/Channel chat ID for incoming order alerts.
TELEGRAM_CHAT_ID=""

# TELEGRAM_GATEWAY_TOKEN: Official Telegram Gateway API token for Phone OTP verification.
TELEGRAM_GATEWAY_TOKEN=""

# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM_NUMBER: Official Twilio SMS OTP credentials.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# SMS_WEBHOOK_URL / SMS_WEBHOOK_API_KEY: Optional HTTP SMS Gateway webhook (e.g. PlasGate / MekongSMS).
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_API_KEY=""

# BAKONG_API_TOKEN: Optional Bakong Open API JWT token for automatic KHQR MD5 transaction verification.
BAKONG_API_TOKEN=""

