{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suan-coffee",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html", "/api/*"]
  }
}
